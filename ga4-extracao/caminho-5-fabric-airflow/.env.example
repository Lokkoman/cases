# Conexao do Airflow com o Fabric, como URI. No provider 0.1.1 o SPN le tudo do
# extra (query string): auth_type, tenantId, clientId, clientSecret.
# Se o secret tiver caractere especial (+ / =), url-encode antes de colar.
AIRFLOW_CONN_FABRIC_CONN=microsoft-fabric://?auth_type=spn&tenantId=f63ceebf-5c0f-4b0c-8837-3c3139c38d92&clientId=ae650abe-f2fa-47bc-96ce-9711cfba0aa6&clientSecret=COLE_O_CLIENT_SECRET_AQUI

# IDs do Fabric (workspace portfolio-ga4 + notebook nb_ga4_bronze_ingest)
FABRIC_WORKSPACE_ID=5794b251-2e37-4dcd-95a2-6e07f81f78ba
FABRIC_NOTEBOOK_ITEM_ID=c82ef87f-273f-4c00-bed2-f66478e9d0e2
