# ID numérico da propriedade GA4.
# Admin do GA4 -> Administração -> Detalhes da propriedade -> "ID da propriedade".
GA4_PROPERTY_ID=123456789

# Rótulo livre que vai no campo "property" do JSON de saída (opcional).
GA4_PROPERTY_LABEL=meu-site

# Conteúdo do JSON da chave da service account, em uma linha.
# Em CI, use um secret (nunca commite este valor).
#   GA_SA_KEY="$(cat service-account.json)"
GA_SA_KEY={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com"}
